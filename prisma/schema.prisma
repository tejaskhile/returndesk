
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  SIZE_ISSUE
  NOT_AS_DESCRIBED
  CHANGED_MIND
}

enum Resolution {
  REFUND
  REPLACEMENT
  STORE_CREDIT
}

model ReturnRequest {
  id            String        @id @default(cuid())
  reference     String        @unique

  customerName  String
  customerEmail String
  customerPhone String?

  orderNumber   String
  itemSku       String
  itemName      String
  quantity      Int

  reason        ReturnReason
  status        RequestStatus @default(OPEN)

  resolution    Resolution?
  refundAmount  Decimal?      @db.Decimal(10, 2)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  notes         Note[]

  @@index([customerName])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([reason, createdAt])
}

model Note {
  id        String        @id @default(cuid())
  content   String
  createdAt DateTime      @default(now())

  requestId String
  request ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
